<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SafeDriver</vendor>
  <action id="org.safedriver.driver-installer.apply">
    <description>Install verified driver and firmware updates</description>
    <message>Authentication is required to install the driver and firmware updates you selected</message>
    <icon_name>software-update-available</icon_name>
    <!-- Always ask for an administrator password; never remember it (no *_keep). -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/driver-installer-helper</annotate>
  </action>
</policyconfig>
